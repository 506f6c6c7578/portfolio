---
import ContactForm from "../components/ContactForm.astro";
import Illustration from "../components/Illustration.astro";
import StructuredData from "../components/StructuredData.astro";
import { contact } from "../data/content";
import { site } from "../data/site";
import Base from "../layouts/Base.astro";
import { turnstile } from "../lib/contact";

Astro.csp?.insertScriptResource("'self'");
Astro.csp?.insertScriptResource(turnstile.origin);
Astro.csp?.insertDirective(`frame-src ${turnstile.origin}`);
---

<Base title={contact.metaTitle} description={contact.description}>
    <StructuredData slot="head" type="ContactPage" title={contact.metaTitle}
                    description={contact.description}/>

    <section class="section-sm">
        <div class="container contact">
            <div class="contact__intro">
                <h1 class="h2">{contact.title}</h1>
                <p>{contact.intro}</p>
                <p>
                    {contact.emailPrompt} <a class="contact__email"
                                             href={`mailto:${site.email}`}>{site.email}</a>.
                </p>
                <Illustration class="contact__illustration" svg={contact.illustration}/>
            </div>
            <div data-animate="up">
                <ContactForm/>
            </div>
        </div>
    </section>
</Base>

<style>
    .contact {
        display: grid;
        gap: 3rem;
    }

    .contact__intro {
        display: grid;
        gap: 1.25rem;
        align-content: start;
        font-size: 1.0625rem;
    }

    .contact__email {
        font-weight: 600;
        color: var(--color-text-dark);
        text-decoration: underline;
        text-underline-offset: 0.25rem;
    }

    .contact__illustration {
        display: none;
    }

    @media (min-width: 64rem) {
        .contact {
            grid-template-columns: 5fr 7fr;
            gap: 4rem;
        }

        .contact__illustration {
            display: block;
            width: 100%;
            max-width: 22rem;
            margin-top: 1.5rem;
        }
    }
</style>
