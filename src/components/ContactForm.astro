---
import { LoaderCircle, Send } from "@lucide/astro";
import { contact } from "../data/content";
import { type ContactField, contactFieldLimits, contactFormText } from "../lib/contact";

const fields = [
    { name: "email", type: "email", autocomplete: "email" },
    { name: "subject", type: "text", autocomplete: "off" },
    { name: "message" }
] as const satisfies readonly { name: ContactField; type?: string; autocomplete?: string }[];
---

<form class="contact-form" novalidate data-contact-form>
    {
        fields.map((field) => {
            const id = `contact-${field.name}`;
            const errorId = `${id}-error`;
            const { label, placeholder } = contact.fields[field.name];
            const attributes = {
                id,
                name: field.name,
                class: "contact-form__input",
                placeholder,
                required: true,
                "aria-describedby": errorId,
                ...contactFieldLimits[field.name]
            };
            return (
                    <div class="contact-form__field">
                        <label class="contact-form__label" for={id}>
                            {label}
                        </label>
                        {"type" in field ? (
                                <input type={field.type} autocomplete={field.autocomplete}
                                       {...attributes}/>
                        ) : (
                                <textarea rows="7" {...attributes}/>
                        )}
                        <p id={errorId} class="contact-form__error"
                           data-contact-error={field.name}/>
                    </div>
            );
        })
    }

    <div class="contact-form__challenge" data-contact-challenge></div>

    <div class="contact-form__footer">
        <button class="btn btn-primary contact-form__submit" type="submit" disabled
                data-contact-submit>
            <Send class="contact-form__icon" size={18}/>
            <LoaderCircle class="contact-form__spinner" size={18}/>
            <span data-contact-submit-label>{contactFormText.submit}</span>
        </button>
        <p class="contact-form__status" role="status" data-contact-status></p>
    </div>

    <noscript>
        <p>Le formulaire nécessite JavaScript : écris-moi directement par e-mail.</p>
    </noscript>
</form>

<script>
    import "../scripts/contact-form";
</script>

<style>
    .contact-form {
        --contact-form-gap: 1.25rem;

        display: grid;
        gap: var(--contact-form-gap);
        padding: 2rem 1.25rem;
        background-color: var(--color-light);
        border-radius: var(--radius-xl);
    }

    .contact-form__field {
        display: grid;
        gap: 0.375rem;
    }

    .contact-form__label {
        font-weight: 600;
        color: var(--color-text-dark);
    }

    .contact-form__input {
        width: 100%;
        padding: 0.625rem 0.875rem;
        font: inherit;
        color: var(--color-text-dark);
        background-color: var(--color-body);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        transition: border-color var(--transition);
    }

    .contact-form__input::placeholder {
        color: var(--color-text-light);
    }

    .contact-form__input:hover,
    .contact-form__input:focus {
        border-color: var(--color-dark);
    }

    .contact-form__input[aria-invalid="true"] {
        border-color: var(--color-error);
    }

    textarea.contact-form__input {
        min-height: 10rem;
        resize: vertical;
    }

    .contact-form__error {
        font-size: 0.875rem;
        color: var(--color-error);
    }

    .contact-form__error:empty,
    .contact-form__status:empty {
        display: none;
    }

    .contact-form__challenge:not([data-interactive]) {
        margin-top: calc(var(--contact-form-gap) * -1);
    }

    .contact-form__footer {
        display: grid;
        gap: 1rem;
        justify-items: start;
    }

    .contact-form__submit :global(.contact-form__spinner),
    .contact-form[aria-busy="true"] .contact-form__submit :global(.contact-form__icon) {
        display: none;
    }

    .contact-form[aria-busy="true"] .contact-form__submit {
        cursor: progress;
        opacity: 1;
    }

    .contact-form[aria-busy="true"] .contact-form__submit :global(.contact-form__spinner) {
        display: block;
        animation: contact-form-spin 1s linear infinite;
    }

    @keyframes contact-form-spin {
        to {
            rotate: 360deg;
        }
    }

    .contact-form__status {
        font-weight: 600;
        color: var(--color-text-dark);
    }

    .contact-form__status[data-state="error"] {
        color: var(--color-error);
    }

    @media (min-width: 48rem) {
        .contact-form {
            padding: 2.5rem;
        }
    }
</style>
