---
import { Menu, X } from "@lucide/astro";
import Logo from "./Logo.astro";
import ThemeSwitcher from "./ThemeSwitcher.astro";
import { contactLink, navigation, type NavigationLink, pages, sections } from "../data/site";
import { getPagePath } from "../lib/url";
import navigationScript from "../scripts/navigation.js?raw";

const pagePath = getPagePath(Astro.url);

const getCurrent = ({ href, section }: NavigationLink) => {
    if (section) return pagePath === pages.home && section === sections.home ? "true" : undefined;
    return href === pagePath ? "page" : undefined;
};
---

<header class="header">
    <div class="container header__inner">
        <Logo/>

        <nav id="site-nav" class="nav" popover aria-label="Navigation principale">
            <ul class="nav__list">
                {
                    navigation.map((link) => (
                            <li>
                                <a class="nav__link" href={link.href} data-section={link.section}
                                   aria-current={getCurrent(link)}>
                                    {link.label}
                                </a>
                            </li>
                    ))
                }
                <li class="nav__contact">
                    <a class="btn btn-outline-primary btn-sm"
                       href={contactLink.href}>{contactLink.label}</a>
                </li>
            </ul>
            <span class="nav__indicator" aria-hidden="true"></span>
        </nav>

        <div class="header__actions">
            <ThemeSwitcher/>
            <a class="btn btn-outline-primary btn-sm header__contact"
               href={contactLink.href}>{contactLink.label}</a>
            <button
                    class="nav-toggle"
                    type="button"
                    popovertarget="site-nav"
                    aria-controls="site-nav"
                    aria-expanded="false"
                    aria-label="Menu de navigation"
                    data-nav-toggle
            >
                <Menu class="nav-toggle__icon nav-toggle__icon--open" size={24}/>
                <X class="nav-toggle__icon nav-toggle__icon--close" size={24}/>
            </button>
        </div>
    </div>
    <script is:inline set:html={navigationScript}/>
</header>

<style>
    .header {
        --glass-background: var(--color-body);
        --glass-filter: none;

        position: sticky;
        top: 0;
        z-index: 30;
        background-color: var(--glass-background);
        backdrop-filter: var(--glass-filter);
        box-shadow: inset 0 -1px 0 var(--color-border),
        0 0.75rem 2rem -1.5rem rgb(0 0 0 / 0.35);
        view-transition-name: site-header;
    }

    @supports (backdrop-filter: blur(0)) and (color: color-mix(in srgb, red, red)) {
        .header {
            --glass-background: color-mix(in srgb, var(--color-body) 72%, transparent);
            --glass-filter: blur(1.25rem) saturate(180%);
        }
    }

    @supports (animation-timeline: scroll()) {
        .header {
            animation-name: header-glass-edge;
            animation-timing-function: linear;
            animation-timeline: scroll(root);
            animation-range: 0 4rem;
        }
    }

    @keyframes header-glass-edge {
        from {
            box-shadow: none;
        }
    }

    .header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        height: var(--header-height);
    }

    .header__actions {
        display: flex;
        align-items: center;
        gap: 1.25rem;
    }

    .header__contact {
        display: none;
    }

    .nav-toggle {
        display: grid;
        place-items: center;
        width: 2.75rem;
        height: 2.75rem;
        padding: 0;
        color: var(--color-text-dark);
        background: none;
        border: 0;
    }

    .nav-toggle :global(.nav-toggle__icon) {
        grid-area: 1 / 1;
        transition: opacity var(--transition),
        rotate 0.3s var(--ease-out);
    }

    .nav-toggle[aria-expanded="true"] :global(.nav-toggle__icon--open) {
        opacity: 0;
        rotate: 90deg;
    }

    .nav-toggle[aria-expanded="false"] :global(.nav-toggle__icon--close) {
        opacity: 0;
        rotate: -90deg;
    }

    .nav {
        position: fixed;
        inset: var(--header-height) 0 auto;
        z-index: 40;
        display: none;
        width: 100%;
        max-height: calc(100vh - var(--header-height));
        margin: 0;
        padding: 0 1rem 1.5rem;
        overflow-y: auto;
        color: inherit;
        background-color: var(--glass-background);
        backdrop-filter: var(--glass-filter);
        border: 0;
        border-bottom: 1px solid var(--color-border);
        opacity: 0;
        translate: 0 -0.5rem;
        transition: opacity var(--transition),
        translate var(--transition),
        overlay var(--transition) allow-discrete,
        display var(--transition) allow-discrete;
    }

    .nav.nav--open {
        display: block;
        opacity: 1;
        translate: 0 0;
    }

    .nav:popover-open {
        display: block;
        opacity: 1;
        translate: 0 0;
    }

    @starting-style {
        .nav:popover-open {
            opacity: 0;
            translate: 0 -0.5rem;
        }
    }

    .nav__list {
        display: grid;
        justify-items: center;
        text-align: center;
    }

    .nav__link {
        display: block;
        padding: 0.75rem;
        font-weight: 600;
        color: var(--color-text-dark);
        text-underline-offset: 0.5rem;
        text-decoration-thickness: 2px;
        transition: color var(--transition);
    }

    .nav__link:hover {
        color: var(--color-primary);
    }

    .nav__link[aria-current] {
        text-decoration-line: underline;
    }

    .nav__contact {
        margin-top: 1rem;
    }

    .nav__indicator {
        display: none;
    }

    @media (min-width: 64rem) {
        .nav-toggle,
        .nav__contact {
            display: none;
        }

        .header__contact {
            display: inline-flex;
        }

        .nav {
            position: relative;
            inset: auto;
            display: block;
            width: auto;
            max-height: none;
            margin-left: auto;
            padding: 0;
            background: none;
            backdrop-filter: none;
            border: 0;
            opacity: 1;
            translate: none;
            overflow: visible;
        }

        .nav__list {
            display: flex;
            gap: 0.5rem;
        }

        .nav__link {
            padding: 0.75rem 0.5rem;
        }

        .nav__link[aria-current] {
            text-decoration-line: none;
        }

        .nav__indicator {
            position: absolute;
            bottom: 0.375rem;
            left: 0;
            display: block;
            width: calc(var(--indicator-width, 0px) - 1rem);
            height: 2px;
            background-color: var(--color-text-dark);
            border-radius: 1px;
            opacity: 0;
            translate: calc(var(--indicator-x, 0px) + 0.5rem) 0;
            view-transition-name: nav-indicator;
        }

        .nav__indicator--visible {
            opacity: 1;
        }

        .nav__indicator--animated {
            transition: translate 0.45s var(--ease-out),
            width 0.45s var(--ease-out),
            opacity var(--transition);
        }
    }

    @media (min-width: 80rem) {
        .nav__list {
            gap: 2rem;
        }
    }
</style>
